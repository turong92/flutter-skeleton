<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for the password-reset mail link. NOT linked to the
	     Runner target (CODE_SIGN_ENTITLEMENTS is unset): a free personal team
	     cannot sign the Associated Domains capability, so a linked file would
	     break its builds. A project with a paid team: change the domain, add the
	     capability in Xcode, and set CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
	     for the Runner target (all three configurations). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.example.com</string>
	</array>
</dict>
</plist>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities.schema.json",
  "title": "capabilities.json — what the skeleton has ready",
  "description": "The single source for 'what already exists' when a project asks for X, Y, Z. docs/capabilities.md and llms.txt are generated from it (dart run tool/build_capabilities.dart). The sibling repos meet here: backend.modules[] <-> kotlin-skeleton docs/modules/README.md, pairsWith.react[] <-> react-skeleton capabilities.json ids.",
  "type": "object",
  "required": ["schemaVersion", "mode", "name", "summary", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "mode": {
      "enum": ["skeleton", "project"],
      "description": "skeleton = the whole catalog of this repo, project = the filtered one a stamped project carries."
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "newProject": {
      "type": "object",
      "description": "(skeleton) the interface of scripts/new-project.sh.",
      "required": ["script", "usage", "positional", "flags"],
      "additionalProperties": false,
      "properties": {
        "script": { "type": "string" },
        "usage": { "type": "string" },
        "positional": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "siblings": {
      "type": "object",
      "description": "(skeleton) repos that sit next to this one. Read only when cloned beside it.",
      "required": ["kotlin", "react"],
      "additionalProperties": false,
      "properties": {
        "kotlin": { "$ref": "#/$defs/sibling" },
        "react": { "$ref": "#/$defs/sibling" }
      }
    },
    "skeleton": {
      "type": "object",
      "description": "(project) the skeleton this project was stamped from.",
      "required": ["name", "pointer"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "pointer": { "type": "string" }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "omitted": {
      "type": "array",
      "description": "(project) in the skeleton but not carried into this project.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "summary", "stampFlag"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["package", "app"] },
          "summary": { "type": "string" },
          "stampFlag": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "sibling": {
      "type": "object",
      "required": ["repo", "catalog"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "description": "Folder name next to this repo." },
        "catalog": { "type": "string", "description": "Catalog path inside that repo." },
        "llms": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "summary",
        "package",
        "path",
        "stampFlag",
        "needs",
        "backend",
        "pairsWith",
        "docs",
        "notFor",
        "keywords"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique. A package is its folder name with hyphens (api-client), an app is app-<folder>."
        },
        "kind": { "enum": ["package", "app"] },
        "summary": { "type": "string", "minLength": 1, "description": "One sentence: what you get." },
        "package": { "type": "string", "description": "The pubspec name." },
        "path": { "type": "string", "minLength": 1, "description": "Folder, relative to the repo root." },
        "stampFlag": {
          "type": "object",
          "required": ["flag", "included"],
          "additionalProperties": false,
          "properties": {
            "flag": { "type": ["string", "null"], "description": "The new-project.sh fragment that brings it in." },
            "included": {
              "enum": ["always", "flag"],
              "description": "always = every stamped project has it (the starter needs it, or it is root tooling). flag = only when asked for."
            }
          }
        },
        "needs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ids of the skeleton packages this one declares in its pubspec."
        },
        "backend": {
          "type": ["object", "null"],
          "description": "The kotlin-skeleton side this talks to. null = no backend.",
          "required": ["modules", "oneOfModules", "optionalModules", "basePaths", "docs"],
          "additionalProperties": false,
          "properties": {
            "modules": { "type": "array", "items": { "type": "string" } },
            "oneOfModules": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            },
            "optionalModules": { "type": "array", "items": { "type": "string" } },
            "basePaths": { "type": "array", "items": { "type": "string" } },
            "docs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Paths inside kotlin-skeleton."
            }
          }
        },
        "pairsWith": {
          "type": "object",
          "required": ["react"],
          "additionalProperties": false,
          "properties": {
            "react": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Ids in react-skeleton's capabilities.json that do the same job on the web."
            }
          }
        },
        "docs": { "type": "array", "items": { "type": "string" }, "description": "Paths inside this repo." },
        "notFor": { "type": "array", "items": { "type": "string" } },
        "keywords": {
          "type": "object",
          "required": ["ko", "en"],
          "additionalProperties": false,
          "properties": {
            "ko": { "type": "array", "items": { "type": "string" } },
            "en": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}

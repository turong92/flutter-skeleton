<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Use "production" for a store build
	     (Xcode switches it for an archive when the capability is added there). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple capability. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links for the mailed password-reset and sign-in links. Needs
	     the Associated Domains capability on your App ID and signing team
	     (like the two above). A project changes only the domain. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.example.com</string>
	</array>
</dict>
</plist>
